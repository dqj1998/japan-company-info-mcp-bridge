{
  "name": "japan-company-info-mcp-bridge",
  "version": "1.2.3",
  "description": "MCP stdio server for verified Japanese corporate data (EDINET XBRL financials, National Tax Agency corporate numbers, gBizINFO) — Free edition, 192 blue-chip listed companies. Bridges the bundled mcporb-runtime.",
  "license": "MIT",
  "mcpName": "io.github.dqj1998/japan-company-info-mcp-bridge",
  "type": "commonjs",
  "main": "index.js",
  "bin": {
    "japan-company-info-mcp-bridge": "index.js"
  },
  "files": [
    "index.js",
    "assets/",
    "glama.json",
    "server.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "optionalDependencies": {
    "@dqj1998/japan-company-info-mcp-bridge-darwin-arm64": "1.2.3",
    "@dqj1998/japan-company-info-mcp-bridge-linux-arm64": "1.2.3",
    "@dqj1998/japan-company-info-mcp-bridge-linux-x64": "1.2.3",
    "@dqj1998/japan-company-info-mcp-bridge-win32-x64": "1.2.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "japan",
    "edinet",
    "corporate-data",
    "financial-data",
    "us-gaap",
    "ifrs",
    "due-diligence",
    "kyb",
    "national-tax-agency",
    "gbizinfo"
  ],
  "homepage": "https://mcporb.store/orb-pages/japan-company-info",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dqj1998/japan-company-info-mcp-bridge.git"
  },
  "scripts": {
    "build": "node -e \"process.exit(0)\"",
    "start": "node index.js",
    "prepare:runtime": "node scripts/prepare-runtime-packages.mjs",
    "publish:runtime": "bash scripts/publish-runtime-packages.sh",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "npm run prepare:runtime && node scripts/smoke-test.mjs",
    "version": "node scripts/sync-optional-deps.mjs && git add package.json server.json",
    "check:listings": "bash scripts/check-listings.sh"
  }
}
